    },
    {
      "source": "/activities/aesdp",
      "destination": "/events/a-esdp-data-science-2026/",
      "permanent": true
    },
    {
      "source": "/activities/aesdp/",
      "destination": "/events/a-esdp-data-science-2026/",
      "permanent": true
    },
    {
      "source": "/activities/industry-acadamia-conclave-2-0",
      "destination": "/events/industry-academia-conclave-2026/",
      "permanent": true
    },
    {
      "source": "/activities/industry-acadamia-conclave-2-0/",
      "destination": "/events/industry-academia-conclave-2026/",
      "permanent": true
    },
    {
      "source": "/activities/ramp",
      "destination": "/events/ramp-mp-laghu-udyog-nigam-orientation-2026/",
      "permanent": true
    },
    {
      "source": "/activities/ramp/",
      "destination": "/events/ramp-mp-laghu-udyog-nigam-orientation-2026/",
      "permanent": true
    },
    {
      "source": "/activities/ramp-day-2-11-may",
      "destination": "/events/ramp-msme-exposure-session-2026/",
      "permanent": true
    },
    {
      "source": "/activities/ramp-day-2-11-may/",
      "destination": "/events/ramp-msme-exposure-session-2026/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
