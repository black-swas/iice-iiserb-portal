    {
      "source": "/activities/",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/activities/upcoming-events",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/activities/upcoming-events/",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/activities/past-events",
      "destination": "/events/?view=past",
      "permanent": true
    },
    {
      "source": "/activities/past-events/",
      "destination": "/events/?view=past",
