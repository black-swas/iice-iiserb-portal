    },
    {
      "source": "/about-us/innovation-club",
      "destination": "/about/innovation-club/",
      "permanent": true
    },
    {
      "source": "/about-us/innovation-club/",
      "destination": "/about/innovation-club/",
      "permanent": true
    },
    {
      "source": "/about-us/support-funding",
      "destination": "/about/support-funding/",
      "permanent": true
    },
    {
      "source": "/about-us/support-funding/",
      "destination": "/about/support-funding/",
      "permanent": true
    },
    {
      "source": "/about-us/resolutions",
      "destination": "/documents/?category=resolution",
      "permanent": true
    },
    {
      "source": "/about-us/resolutions/",
      "destination": "/documents/?category=resolution",
      "permanent": true
    },
    {
      "source": "/about-us/incubation-policy",
      "destination": "/documents/?category=policy",
      "permanent": true
