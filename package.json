{
  "name": "iice-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official website of IICE, the DST NIDHI-TBI technology business incubator at IISER Bhopal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run images && npm run og && npm run ics && npm run rss && npm run search-index -- --all",
    "dev": "next dev",
    "prebuild": "npm run content:validate && npm run form-rules -- --check && npm run images && npm run og && npm run ics && npm run rss && npm run redirects && npm run search-index",
    "build": "next build",
    "start": "serve out -l 3000 --no-clipboard",
    "postbuild": "npm run redirects -- --stubs && npm run csp",
    "images": "tsx scripts/images.ts",
    "search-index": "tsx scripts/search-index.ts",
    "og": "tsx scripts/og.ts",
    "ics": "tsx scripts/ics.ts",
    "rss": "tsx scripts/rss.ts",
    "redirects": "tsx scripts/redirects.ts",
    "csp": "tsx scripts/csp.ts",
    "audit:html": "tsx scripts/audit-html.ts",
    "size": "tsx scripts/size.ts",
    "links": "tsx scripts/links.ts",
    "lhci": "tsx scripts/lhci.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "tsx scripts/e2e.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:stale": "tsx scripts/stale-content.ts",
    "todo:confirm": "tsx scripts/todo-confirm.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "cms:config": "tsx scripts/cms-config.ts",
    "cms": "decap-server",
    "form-rules": "tsx scripts/form-rules.ts",
    "spell": "cspell --no-progress --no-must-find-files \"messages/**/*.json\" \"content/**/*.{json,md,mdx}\" \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" SPEC.md"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.0",
    "cmdk": "1.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.56.0",
    "minisearch": "7.2.0",
    "motion": "14.2.0",
    "next": "16.4.0",
    "next-mdx-remote-client": "2.1.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.3.6",
    "decap-server": "3.11.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "linkinator": "8.1.0",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
