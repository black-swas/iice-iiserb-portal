{
  "version": 1,
  "forms": {
    "contact": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+\\d][\\d\\s-]{7,17}$"
          },
          "organisation": {
            "type": "string",
            "maxLength": 120
          },
          "topic": {
            "type": "string",
            "enum": [
              "incubation",
              "partnership-funding",
              "mentoring",
              "facilities-bookings",
              "media",
              "careers",
              "birac-edge",
              "event-invite",
              "other"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 20,
            "maxLength": 3000
          }
        },
        "required": [
          "name",
          "email",
          "topic",
          "message"
        ]
      },
      "conditions": []
    },
    "pitch": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+\\d][\\d\\s-]{7,17}$"
          },
          "ventureName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "oneLiner": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          },
          "stage": {
            "type": "string",
            "enum": [
              "idea",
              "proof-of-concept",
              "prototype",
              "early-revenue",
              "scaling"
            ]
          },
          "sector": {
            "type": "string",
            "enum": [
              "healthcare-bioengineering",
              "environment-agriculture",
              "iot-ai",
              "social-rural-development",
              "computational-sciences-it",
              "other"
            ]
          },
          "affiliation": {
            "type": "string",
            "enum": [
              "iiserb-faculty",
              "iiserb-former-faculty",
              "iiserb-student",
              "iiserb-alumni",
              "partner-university",
              "external"
            ]
          },
          "assistanceSought": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "incubation-space",
                "lab-access",
                "mentoring",
                "funding",
                "ip-legal",
                "market-access"
              ]
            }
          },
          "deckUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "email",
          "ventureName",
          "oneLiner",
          "stage"
        ]
      },
      "conditions": []
    },
    "application": {
      "schema": {
        "type": "object",
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "track": {
                "type": "string",
                "enum": [
                  "physical",
                  "virtual",
                  "pre-incubation",
                  "co-development"
                ]
              },
              "stage": {
                "type": "string",
                "enum": [
                  "catalyse",
                  "culture",
                  "commercialise"
                ]
              },
              "schemeSlug": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "opportunitySlug": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "applicant": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string",
                "pattern": "^[+\\d][\\d\\s-]{7,17}$"
              },
              "affiliation": {
                "type": "string",
                "enum": [
                  "iiserb-faculty",
                  "iiserb-former-faculty",
                  "iiserb-student",
                  "iiserb-alumni",
                  "partner-university",
                  "external"
                ]
              },
              "institution": {
                "type": "string",
                "maxLength": 160
              },
              "iiserbMentor": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "department": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              },
              "linkedin": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "email",
              "phone",
              "affiliation"
            ]
          },
          "venture": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              },
              "incorporated": {
                "type": "boolean"
              },
              "legalEntity": {
                "type": "string",
                "enum": [
                  "pvt-ltd",
                  "llp",
                  "partnership",
                  "proprietorship",
                  "section-8",
                  "not-yet"
                ]
              },
              "incorporationDate": {
                "type": "string",
                "format": "date"
              },
              "website": {
                "type": "string",
                "format": "uri"
              },
              "sector": {
                "type": "string",
                "enum": [
                  "healthcare-bioengineering",
                  "environment-agriculture",
                  "iot-ai",
                  "social-rural-development",
                  "computational-sciences-it",
                  "other"
                ]
              },
              "stage": {
                "type": "string",
                "enum": [
                  "idea",
                  "proof-of-concept",
                  "prototype",
                  "early-revenue",
                  "scaling"
                ]
              },
              "problem": {
                "type": "string",
                "minLength": 50,
                "maxLength": 1500
              },
              "solution": {
                "type": "string",
                "minLength": 50,
                "maxLength": 1500
              },
              "market": {
                "type": "string",
                "minLength": 30,
                "maxLength": 1500
              },
              "teamSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "team": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "required": [
                    "name",
                    "role"
                  ]
                }
              },
              "fundingToDate": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "name",
              "incorporated",
              "sector",
              "stage",
              "problem",
              "solution",
              "market",
              "teamSize"
            ]
          },
          "technology": {
            "type": "object",
            "properties": {
              "ipStatus": {
                "type": "string",
                "enum": [
                  "none",
                  "in-preparation",
                  "filed",
                  "granted",
                  "licensed-in"
                ]
              },
              "developedAtIiserb": {
                "type": "boolean"
              },
              "ipDetails": {
                "type": "string",
                "maxLength": 1500
              },
              "patentNumbers": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "ipDocsUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "ipStatus",
              "developedAtIiserb"
            ]
          },
          "needs": {
            "type": "object",
            "properties": {
              "preferredStage": {
                "type": "string",
                "enum": [
                  "catalyse",
                  "culture",
                  "commercialise"
                ]
              },
              "officeSeats": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50
              },
              "labSpace": {
                "type": "boolean"
              },
              "equipment": {
                "type": "string",
                "maxLength": 800
              },
              "mentoringAreas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "technical",
                    "business",
                    "ip-legal",
                    "regulatory",
                    "fundraising",
                    "marketing"
                  ]
                }
              }
            },
            "required": [
              "preferredStage",
              "officeSeats",
              "labSpace"
            ]
          },
          "documents": {
            "type": "object",
            "properties": {
              "businessPlanUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "businessPlanUrl"
            ]
          },
          "declarations": {
            "type": "object",
            "properties": {
              "infoAccurate": {
                "type": "boolean",
                "const": true
              },
              "agreeToPolicy": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "infoAccurate",
              "agreeToPolicy"
            ]
          }
        },
        "required": [
          "applicant",
          "venture",
          "technology",
          "needs",
          "documents",
          "declarations"
        ]
      },
      "conditions": [
        {
          "code": "mentorRequired",
          "when": [
            {
              "path": "applicant.affiliation",
              "in": [
                "partner-university",
                "external"
              ]
            }
          ],
          "require": [
            "applicant.iiserbMentor.name",
            "applicant.iiserbMentor.email"
          ],
          "errorPath": "applicant.iiserbMentor.name",
          "message": "Applicants from partner universities or outside IISER Bhopal need an IISER Bhopal faculty mentor or collaborator."
        },
        {
          "code": "ipDocsRequired",
          "when": [
            {
              "path": "technology.developedAtIiserb",
              "equals": true
            },
            {
              "path": "technology.ipStatus",
              "in": [
                "filed",
                "granted"
              ]
            }
          ],
          "require": [
            "technology.ipDocsUrl"
          ],
          "errorPath": "technology.ipDocsUrl",
          "message": "For IP developed at IISER Bhopal, share a link to the filed or granted patent application."
        },
        {
          "code": "legalEntityRequired",
          "when": [
            {
              "path": "venture.incorporated",
              "equals": true
            }
          ],
          "require": [
            "venture.legalEntity"
          ],
          "errorPath": "venture.legalEntity",
          "message": "Select the legal entity type."
        }
      ]
    },
    "mentor": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+\\d][\\d\\s-]{7,17}$"
          },
          "linkedin": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "organisation": {
            "type": "string",
            "maxLength": 120
          },
          "types": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "business",
                "finance",
                "technical",
                "legal",
                "ip",
                "regulatory",
                "clinical-domain",
                "marketing"
              ]
            }
          },
          "sectors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "healthcare-bioengineering",
                "environment-agriculture",
                "iot-ai",
                "social-rural-development",
                "computational-sciences-it",
                "other"
              ]
            }
          },
          "expertise": {
            "type": "string",
            "minLength": 20,
            "maxLength": 800
          },
          "engagement": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "one-to-one",
                "workshops",
                "jury-evaluation",
                "office-hours",
                "investor-connect"
              ]
            }
          },
          "hoursPerMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        },
        "required": [
          "name",
          "email",
          "title",
          "organisation",
          "types",
          "sectors",
          "expertise",
          "engagement"
        ]
      },
      "conditions": []
    },
    "partner": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "designation": {
            "type": "string",
            "maxLength": 100
          },
          "organisation": {
            "type": "string",
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+\\d][\\d\\s-]{7,17}$"
          },
          "partnershipType": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "co-invest",
                "csr",
                "sponsor-challenge",
                "pilot-customer",
                "academic",
                "mentor-network",
                "other"
              ]
            }
          },
          "sectorFocus": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "healthcare-bioengineering",
                "environment-agriculture",
                "iot-ai",
                "social-rural-development",
                "computational-sciences-it",
                "other"
              ]
            }
          },
          "fundsAvailable": {
            "type": "string",
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        },
        "required": [
          "name",
          "designation",
          "organisation",
          "email",
          "partnershipType",
          "message"
        ]
      },
      "conditions": []
    },
    "booking": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^[+\\d][\\d\\s-]{7,17}$"
          },
          "organisation": {
            "type": "string",
            "maxLength": 160
          },
          "userCategory": {
            "type": "string",
            "enum": [
              "incubatee",
              "iiserb",
              "external-academic",
              "industry"
            ]
          },
          "facilitySlug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "instrumentSlug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "preferredDates": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          },
          "durationEstimate": {
            "type": "string",
            "maxLength": 60
          },
          "sampleDetails": {
            "type": "string",
            "maxLength": 800
          },
          "notes": {
            "type": "string",
            "maxLength": 800
          }
        },
        "required": [
          "name",
          "email",
          "phone",
          "organisation",
          "userCategory",
          "preferredDates",
          "durationEstimate"
        ]
      },
      "conditions": [
        {
          "code": "targetRequired",
          "when": [],
          "requireAny": [
            "facilitySlug",
            "instrumentSlug"
          ],
          "errorPath": "instrumentSlug",
          "message": "Choose a facility or an instrument."
        }
      ]
    },
    "newsletter": {
      "schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "calls",
                "events",
                "news"
              ]
            }
          }
        },
        "required": [
          "email"
        ]
      },
      "conditions": []
    }
  }
}
