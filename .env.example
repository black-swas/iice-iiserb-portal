# Copy to .env.local for development. NEXT_PUBLIC_* values are embedded in the client bundle: never put secrets here.
# Reference: docs/TRD.md §15.1

# Canonical origin for canonical URLs, sitemap and Open Graph tags. No trailing slash.
# On Vercel set it under Project Settings > Environment Variables (the *.vercel.app address until the real domain is connected).
NEXT_PUBLIC_SITE_URL=https://iice.iiserb.ac.in

# Form POST target (Google Apps Script web app or any compatible endpoint). Empty = forms fall back to mailto:
NEXT_PUBLIC_FORM_ENDPOINT=

# none | plausible | umami. Cookieless providers only; GA4 needs a consent banner the site does not have, so it enables nothing.
# Turning analytics on changes what the privacy page may say: it currently says the site has no tracking code (SRD Q7).
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: the domain. Umami: the website id.
NEXT_PUBLIC_ANALYTICS_ID=
# Only for a self-hosted provider, e.g. https://stats.iiserb.ac.in. Defaults to plausible.io or cloud.umami.is.
NEXT_PUBLIC_ANALYTICS_HOST=

# Set to 1 on preview deploys to show the TODO_CONFIRM placeholder banner outside development
NEXT_PUBLIC_SHOW_TODOS=

# Click-to-load map embed URL (Google Maps or OpenStreetMap)
NEXT_PUBLIC_MAP_EMBED_URL=
