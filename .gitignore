# Legacy offline mirror of the old Google Site: content reference only (never committed, built or linted)
/legacy/

# Dependencies
/node_modules/
.pnp
.pnp.*
.yarn/*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# Generated by the prebuild pipeline (TRD §3, §6, §16)
/public/_img/
/public/search-index.json
/public/og/
/public/news/rss.xml
/public/events/*.ics
/public/.htaccess
/public/_redirects
/public/_headers
/deploy/

# Test, coverage and audit output
/coverage/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# Environment (only .env.example is committed; NEXT_PUBLIC_* values are public but still per-environment)
.env
.env.*
!.env.example

# Caches
.cache/
.eslintcache
.turbo/
.vercel/

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.log

# Claude Code local state
.claude/settings.local.json
